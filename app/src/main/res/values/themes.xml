<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="night">#070816</color>
    <color name="icon_bg">#0B0E25</color>
    <style name="Theme.Noctea" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/night</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
    </style>
    <style name="Theme.Noctea.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/night</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_splash_moon</item>
        <item name="postSplashScreenTheme">@style/Theme.Noctea</item>
    </style>
</resources>
