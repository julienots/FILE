{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 24, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}"
    },
    { "name": "debug",   "inherits": "base", "displayName": "Debug",   "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" } },
    { "name": "release", "inherits": "base", "displayName": "Release", "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" } },
    {
      "name": "asan", "inherits": "base", "displayName": "Debug + Address/UB sanitizers",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "AGR_ENABLE_ASAN": "ON" }
    },
    {
      "name": "headless", "inherits": "base", "displayName": "Core only (no SDL3, CI / servers)",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "AGR_BUILD_PLATFORM": "OFF" }
    }
  ],
  "buildPresets": [
    { "name": "debug",    "configurePreset": "debug" },
    { "name": "release",  "configurePreset": "release" },
    { "name": "asan",     "configurePreset": "asan" },
    { "name": "headless", "configurePreset": "headless" }
  ],
  "testPresets": [
    { "name": "debug",    "configurePreset": "debug",    "output": { "outputOnFailure": true } },
    { "name": "release",  "configurePreset": "release",  "output": { "outputOnFailure": true } },
    { "name": "asan",     "configurePreset": "asan",     "output": { "outputOnFailure": true } },
    { "name": "headless", "configurePreset": "headless", "output": { "outputOnFailure": true } }
  ]
}
