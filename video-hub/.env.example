# ======================= Hub =======================
# URL publique du hub (HTTPS). Indispensable : CUTTINX télécharge les rushs depuis cette adresse.
PUBLIC_BASE_URL=https://mon-hub.exemple.com
HUB_USERNAME=admin
HUB_PASSWORD=change-moi
# Chaîne aléatoire longue (signature des liens de téléchargement) : python -c "import secrets;print(secrets.token_hex(32))"
HUB_SECRET=
HUB_DATA_DIR=./data
MAX_UPLOAD_MB=2048

# ============ Retour des rendus depuis le téléphone ============
# Jeton pour POST /api/renders/inbox (automatisation du téléphone)
RENDER_UPLOAD_TOKEN=
# Dossier synchronisé avec Movies/Cuttinx du téléphone (Syncthing, rclone...) — facultatif
RENDER_INBOX_DIR=
# Délai max d'attente du MP4 avant erreur (heures)
RENDER_WAIT_HOURS=12

# ======================= Montage =======================
# claude = Claude monte lui-même via le MCP CUTTINX (recommandé) ; direct = recette automatique sans Claude
EDITOR_MODE=claude
CUTTINX_MCP_URL=
CUTTINX_MCP_TOKEN=
# media_id CUTTINX d'une musique par défaut pour les vidéos performance (facultatif)
DEFAULT_MUSIC_MEDIA_ID=
RENDER_RESOLUTION=1080

# ======================= Claude =======================
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EDIT_EFFORT=high
CLAUDE_CAPTION_EFFORT=medium
# Repli automatique sur un autre modèle si une requête est refusée
CLAUDE_FALLBACKS=true

# ======================= Instagram =======================
IG_USERNAME=julien.blt.bs
# ID du compte Instagram professionnel (pas la page Facebook)
IG_USER_ID=
# Jeton d'accès de page (longue durée) avec instagram_basic, instagram_content_publish, pages_show_list, pages_read_engagement
IG_ACCESS_TOKEN=
IG_GRAPH_VERSION=v21.0
# resumable = le hub envoie le fichier à Instagram ; url = Instagram télécharge depuis PUBLIC_BASE_URL
IG_UPLOAD_MODE=resumable
IG_SHARE_TO_FEED=true
# true = tout le pipeline tourne mais rien n'est publié (pour tester)
DRY_RUN_PUBLISH=false

# ======================= Programmation =======================
TIMEZONE=Europe/Paris
PEAK_HOURS_WEEKDAY=12:30,18:30,21:00
PEAK_HOURS_WEEKEND=11:00,18:00,20:30
MIN_GAP_MINUTES=180

# ======================= Hashtags de base =======================
BASE_HASHTAGS_PERFORMANCE=streetworkout,calisthenics,calisthenicsmotivation,bodyweight
BASE_HASHTAGS_NORMAL=vlog

# ======================= Relances & notifications =======================
MAX_ATTEMPTS=4
RETRY_BASE_SECONDS=60
# ntfy (appli mobile gratuite) : https://ntfy.sh/un-nom-de-topic-secret
NTFY_URL=
# Webhook Discord / Slack
NOTIFY_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
NOTIFY_ON_RETRY=false
NOTIFY_ON_SUCCESS=true
